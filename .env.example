# --8<-- encabezado-grupo
# Archivo: .env.example
# Objetivo: Plantilla de variables de entorno (valores ficticios) para la Tarea 2 (all-local + gateway).
# Grupo del curso: Fabio Durán - Gustavo Reyes - Ezequiel Muñoz
# Creación: 20261117 1544
# Última modificación: 20261117 2210
# --8<-- fin-encabezado-grupo

# Modelo (Gemini) — la clave la pone cada quien; NUNCA se versiona el .env real.
MODELO=gemini-3.5-flash-lite
GOOGLE_API_KEY=tu-clave-de-gemini

# Gateway FastAPI: API_KEY que protege los endpoints que invocan agentes (header X-API-Key).
API_KEY=define-una-api-key-fuerte-para-el-gateway

# Coordinador ALL-LOCAL: los 8 agentes corren locales (langgraph dev en :2025). Sin compañeros remotos.
A2A_BASE=http://127.0.0.1:2025
A2A_GRAFOS_LOCALES=agente_machinelearning,agente_mlbioinformatica,agente_bioinformatica,agente_reiki,agente_cocinachilena,agente_meteorologia,agente_viajes,agente_administrador
# (En T2 NO se usa URLS_AGENTES: no hay agentes de compañeros.)

# RAG de Reiki: local por ahora; cambiar a Redis cloud cuando llegue la URL (requiere RediSearch).
RAG_BACKEND=local
REDIS_URL=redis://usuario:password@host:puerto/0

# Persistencia SQLite (rutas por defecto bajo logs/ si se omiten).
# MEMORIA_DB=logs/memoria.sqlite
# CLIMA_DB=logs/clima.sqlite
# CONFIG_DB=logs/config.sqlite
# USUARIOS_DB=logs/usuarios.sqlite

# Frontend web (BFF) y gateway interno
API_BASE=http://127.0.0.1:8796
WEB_HOST=127.0.0.1
WEB_PORT=8797

# Usuarios del chat (login por sesión). La clave inicial es ÚNICA y cada uno la cambia al primer ingreso.
WEB_USUARIOS=ezequiel,gustavo,fabio,cristobal,jose
WEB_ADMIN=ezequiel
CLAVE_INICIAL=clave-inicial-unica-a-repartir

# Monitor / backoffice (:8798)
MONITOR_HOST=127.0.0.1
MONITOR_PORT=8798
MONITOR_USER=monitor
MONITOR_PASS=define-una-clave-del-monitor

# Correo de despacho (buzón dedicado). La clave va en el .env real, no aquí.
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=tarea2curso2@etmk.cl
SMTP_PASS=la-clave-del-buzon
MAIL_FROM=tarea2curso2@etmk.cl
