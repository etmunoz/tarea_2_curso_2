# --8<-- encabezado-grupo
# Archivo: deploy/t2c2.env.example
# Objetivo: Plantilla del EnvironmentFile /etc/t2c2.env (valores ficticios) para los servicios t2c2-*.
# Grupo del curso: Fabio Durán - Gustavo Reyes - Ezequiel Muñoz
# --8<-- fin-encabezado-grupo
# Copiar a /etc/t2c2.env, completar con valores REALES, y: chown root:client1 /etc/t2c2.env ; chmod 640 /etc/t2c2.env
MODELO=gemini-3.5-flash-lite
GOOGLE_API_KEY=pega-tu-clave-de-gemini
API_KEY=define-una-api-key-fuerte-para-el-gateway
# Coordinador all-local (langgraph en :2025) con los 9 grafos (incluye meteo_mcp)
A2A_BASE=http://127.0.0.1:2025
A2A_GRAFOS_LOCALES=agente_machinelearning,agente_mlbioinformatica,agente_bioinformatica,agente_reiki,agente_cocinachilena,agente_meteorologia,agente_viajes,agente_administrador,meteo_mcp
# Agente meteo_mcp (clima mundial via MCP de Meteosource). Token de PAGO: completa el valor REAL aqui en
# /etc/t2c2.env, nunca en el repo. Si falta, meteo_mcp cae a Open-Meteo (respaldo keyless).
MCP_SERVER_METEOSOURCE=https://mcp.meteosource.com/mcp
URL_METEO_MCP=http://127.0.0.1:8005
MCP_BEARER_TOKEN_ENV_VAR=pega-tu-api-key-de-meteosource
# Memoria durable del coordinador (opcional): con PG_DSN usa PostgresSaver; sin el, InMemorySaver.
# Crea rol/base t2c2 en Postgres y rota la clave en el VPS (ver deploy/README-T2.md).
# PG_DSN=postgresql://t2c2:la-clave-rotada@localhost:5432/t2c2
# BFF -> FastAPI
API_BASE=http://127.0.0.1:8796
WEB_HOST=127.0.0.1
WEB_PORT=8797
WEB_USER=admin
WEB_PASS=define-una-clave-de-login-del-sitio
# RAG de Reiki (local hasta tener Redis cloud)
RAG_BACKEND=local
REDIS_URL=redis://usuario:password@host:puerto/0
# Correo de despacho (buzon dedicado)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=tarea2curso2@etmk.cl
SMTP_PASS=la-clave-del-buzon
MAIL_FROM=tarea2curso2@etmk.cl
# Monitor/backoffice (:8798)
MONITOR_HOST=127.0.0.1
MONITOR_PORT=8798
MONITOR_USER=monitor
MONITOR_PASS=define-una-clave-del-monitor
